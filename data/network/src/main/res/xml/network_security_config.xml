<network-security-config>
    <!--
      Cleartext HTTP is blocked everywhere else. It is allowed only for loopback and the
      emulator host so local AI servers (for example, LM Studio or Ollama) work. Network
      Security Config cannot match LAN address ranges, so other local HTTP hosts stay blocked.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
