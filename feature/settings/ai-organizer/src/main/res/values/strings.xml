<resources>
    <string name="ai_organizer">AI Organizer</string>
    <string name="ai_organizer_data_disclosure">When you organize, the launcher sends your home screen grid items (component name, package name, label, page and position), your app drawer applications (package name, component name, serial number and label), and the page count, columns and rows to the endpoint below. Your API key is sent as a bearer token and your system instructions are sent as the system message.</string>
    <string name="ai_organizer_endpoint">Endpoint URL</string>
    <string name="ai_organizer_cleartext_warning">This endpoint uses unencrypted HTTP. Your API key and home screen data can be read by anyone on the network path. Use HTTPS unless the server is on this device.</string>
    <string name="ai_organizer_api_key">API key</string>
    <string name="ai_organizer_model">Model</string>
    <string name="ai_organizer_system_instructions">System instructions</string>
    <string name="ai_organizer_save">Save</string>
    <string name="ai_organizer_new_home_available">A new organization is ready to apply.</string>
    <string name="ai_organizer_no_new_home">No new organization is ready.</string>
    <string name="ai_organizer_apply">Apply</string>
    <string name="ai_organizer_backup_available">A backup is available to restore.</string>
    <string name="ai_organizer_no_backup">No backup to restore.</string>
    <string name="ai_organizer_backup">Back up current home</string>
    <string name="ai_organizer_backup_required">Back up your current home before applying a new organization.</string>
    <string name="ai_organizer_restore">Restore</string>
    <string name="ai_organizer_apply_missing_file">No organization is ready to apply.</string>
    <string name="ai_organizer_apply_invalid_file">The organization does not match the current home screen. Organize again.</string>
    <string name="ai_organizer_apply_failed">Applying the organization failed.</string>
    <string name="ai_organizer_backup_saved">Current home backed up.</string>
    <string name="ai_organizer_settings_saved">Settings saved.</string>
